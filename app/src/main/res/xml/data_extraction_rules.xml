<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="notas.db" />
        <exclude domain="database" path="notas.db-wal" />
        <exclude domain="database" path="notas.db-shm" />
        <exclude domain="database" path="notas.db-journal" />
        <exclude domain="sharedpref" path="noteharbor.preferences.xml" />
        <exclude domain="sharedpref" path="noteharbor.cloud-backup.xml" />
        <exclude domain="sharedpref" path="noteharbor.secure-secrets.xml" />
        <!-- Método de desbloqueio + embrulhos das notas protegidas. O caminho de restauração é o
             backup do Drive (envelope cifrado por senha de recuperação); não viajar no Auto Backup. -->
        <exclude domain="sharedpref" path="noteharbor.security.preferences.xml" />
        <exclude domain="file" path="attachments/" />
        <exclude domain="file" path="attachment_cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="notas.db" />
        <exclude domain="database" path="notas.db-wal" />
        <exclude domain="database" path="notas.db-shm" />
        <exclude domain="database" path="notas.db-journal" />
        <exclude domain="sharedpref" path="noteharbor.preferences.xml" />
        <exclude domain="sharedpref" path="noteharbor.cloud-backup.xml" />
        <exclude domain="sharedpref" path="noteharbor.secure-secrets.xml" />
        <!-- Método de desbloqueio + embrulhos das notas protegidas. O caminho de restauração é o
             backup do Drive (envelope cifrado por senha de recuperação); não viajar no Auto Backup. -->
        <exclude domain="sharedpref" path="noteharbor.security.preferences.xml" />
        <exclude domain="file" path="attachments/" />
        <exclude domain="file" path="attachment_cache/" />
    </device-transfer>
</data-extraction-rules>
